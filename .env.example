# Copie este arquivo para .env.local e preencha com os dados reais da empresa.
# Todas as variáveis são opcionais — campos vazios simplesmente não aparecem no site.

# URL pública do site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=

# WhatsApp: somente dígitos, com DDI e DDD. Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail de contato exibido no site
NEXT_PUBLIC_CONTACT_EMAIL=

# Endpoint que recebe o formulário de contato via POST JSON
# (Formspree, Getform, Basin, webhook próprio…). Vazio = o formulário envia pelo WhatsApp.
NEXT_PUBLIC_FORM_ENDPOINT=

# Subpasta de publicação, se houver. Ex. (GitHub Pages): /arcondicionadodcryo
NEXT_PUBLIC_BASE_PATH=
